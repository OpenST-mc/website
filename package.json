{
  "name": "openst",
  "version": "5.0.0",
  "description": "OpenST 官方网站：React + Vike SSG 门户与存档提交系统",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build:sitemap": "node data/sitemap.js",
    "build:ArchiveCSS": "tailwindcss -i ./css/ArchiveInput.css -o ./css/ArchiveOutput.css --minify",
    "build:PortalCSS": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "build:AdminCSS": "tailwindcss -i ./css/AdminInput.css -o ./css/AdminOutput.css --minify",
    "build:vendor": "node scripts/build-vendor.js",
    "build:static": "node scripts/build-static.ts",
    "check:build": "node scripts/check-build.ts",
    "worker:dev": "wrangler dev --config wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --outdir workers/dist --config wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc",
    "lint": "eslint .",
    "check:types": "tsc --noEmit",
    "doctor": "react-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:emoji": "node scripts/emoji-guard.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:paths": "node scripts/check-paths.js",
    "build": "node data/build.ts && pnpm run build:sitemap && pnpm run build:ArchiveCSS && pnpm run build:PortalCSS && pnpm run build:AdminCSS && pnpm run build:vendor && vite build && pnpm run build:static && pnpm run check:build"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@tailwindcss/cli": "^4.2.4",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-streaming": "0.4.21",
    "sharp": "0.35.5",
    "vike": "0.4.267",
    "vike-react": "0.6.29"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "deepslate": "^0.10.1",
    "dompurify": "^3.4.14",
    "esbuild": "0.28.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gl-matrix": "^3.4.3",
    "jsdom": "30.1.2",
    "jszip": "^3.10.1",
    "marked": "^18.0.10",
    "material-icons": "^1.13.14",
    "pako": "^3.0.1",
    "prettier": "^3.6.2",
    "react-doctor": "0.9.17",
    "tailwindcss": "^4.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^7.3.1",
    "vitest": "5.0.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
