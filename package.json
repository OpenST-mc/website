{
  "name": "openst",
  "version": "4.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build:sitemap": "node archive/scripts/sitemap.js",
    "build:ArchiveCSS": "tailwindcss -i ./css/ArchiveInput.css -o ./css/ArchiveOutput.css --minify",
    "build:PortalCSS": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "build": "npm run build:sitemap && node archive/scripts/build.js && npm run build:ArchiveCSS && npm run build:PortalCSS && vite build"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.3",
    "sharp": "^0.34.5",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "tailwindcss": "^4.2.4",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
